FROM nvcr.io/nvidia/tensorrt:26.05-py3@sha256:94aa793e6db548940168186172b5acbe413cae9e56f7a656d171cd0dd9b6a869

ARG TORCH_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu121

WORKDIR /workspace/YOLOZU

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/workspace/YOLOZU

# Minimal OS deps for common Python wheels + git for run records.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# YOLOZU intentionally keeps torch out of requirements; this image is for GPU backend validation.
RUN python3 tools/ci/install_with_hashes.py \
      --requirements requirements-locks/requirements-runtime.lock \
      --requirements requirements-locks/requirements-rtdetr-pose-image-extra.lock \
      --extra-index-url "${TORCH_EXTRA_INDEX_URL}" \
      --install-local-wheel \
      --local-wheel-source .
