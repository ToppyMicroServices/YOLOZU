ARG PYTHON_IMAGE=python:3.11-slim-bookworm@sha256:97b0eafb29f5ebfba254be840115b2f3bc24ff6ff3de9b905e04b74ee7227ba6
FROM ${PYTHON_IMAGE}

WORKDIR /opt/yolozu

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE NOTICE COPYRIGHT ./
COPY requirements-runtime.lock requirements-demo-extra.lock ./
COPY tools/ci/install_with_hashes.py tools/ci/install_with_hashes.py
COPY yolozu ./yolozu

RUN python tools/ci/install_with_hashes.py \
    --requirements requirements-runtime.lock \
    --requirements requirements-demo-extra.lock \
    --install-local-wheel

RUN useradd --create-home --uid 10001 yolozu && \
    chown -R yolozu:yolozu /opt/yolozu
USER yolozu

ENTRYPOINT ["yolozu"]
CMD ["--help"]
