FROM nvcr.io/nvidia/tensorrt:26.02-py3@sha256:bf56f269a505dfbba09ed146a428cc9f6c952f167bc08df53d5354d217eac0d3

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/YOLOZU
COPY examples/infer_cpp ./examples/infer_cpp

RUN cmake -S examples/infer_cpp -B /build \
      -DYOLOZU_INFER_BUILD_ONNXRT=OFF && \
    cmake --build /build -j

WORKDIR /build

CMD ["./yolozu_infer_trt", "--help"]
