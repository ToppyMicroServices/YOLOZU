FROM nvcr.io/nvidia/tensorrt:26.08-py3@sha256:3b127f45630cd56bf43d2ef70d7f50a7ee37e42bda4ba11adaaa069af2098125

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/YOLOZU
COPY examples/infer_cpp ./examples/infer_cpp

RUN cmake -S examples/infer_cpp -B /build \
      -DYOLOZU_INFER_BUILD_ONNXRT=OFF && \
    cmake --build /build -j

WORKDIR /build

CMD ["./yolozu_infer_trt", "--help"]
