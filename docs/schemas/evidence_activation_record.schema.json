{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.toppymicros.com/yolozu/schemas/evidence_activation_record.schema.json",
  "title": "YOLOZU EvidenceActivationRecord v1",
  "description": "One event in an append-only per-selection-key evidence activation stream.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stream_id",
    "selection_key",
    "sequence",
    "previous_event_digest",
    "event_id",
    "report_id",
    "report_digest",
    "state",
    "replacement_report_id",
    "replacement_report_digest",
    "activated_at",
    "valid_until",
    "reviewer_role_id",
    "review_reference",
    "issuer_claim",
    "trust_domain",
    "reason",
    "event_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "stream_id": { "$ref": "#/$defs/sha256" },
    "selection_key": { "$ref": "#/$defs/sha256" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "previous_event_digest": { "$ref": "#/$defs/sha256" },
    "event_id": { "$ref": "#/$defs/component" },
    "report_id": { "$ref": "#/$defs/component" },
    "report_digest": { "$ref": "#/$defs/sha256" },
    "state": { "enum": ["active", "superseded", "revoked"] },
    "replacement_report_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "replacement_report_digest": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "activated_at": { "$ref": "#/$defs/utc" },
    "valid_until": { "$ref": "#/$defs/utc" },
    "reviewer_role_id": {
      "enum": ["repo_maintainer", "release_reviewer", "site_operator", "automation"]
    },
    "review_reference": { "$ref": "#/$defs/review_reference" },
    "issuer_claim": {
      "enum": ["repository_source", "site_source", "operator_source", "unknown"]
    },
    "trust_domain": {
      "enum": ["yolozu_managed", "site_managed", "operator_asserted", "unknown"]
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "event_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "component": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "review_reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "public_repository_id" },
            "value": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "status"],
          "properties": {
            "kind": { "const": "site_local_status" },
            "status": { "enum": ["present", "not_applicable"] }
          }
        }
      ]
    }
  }
}
