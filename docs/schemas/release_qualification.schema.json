{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.toppymicros.com/yolozu/schemas/release_qualification.schema.json",
  "title": "YOLOZU release qualification decision",
  "type": "object",
  "required": [
    "schema_version",
    "pack_format",
    "decision",
    "passed",
    "checks",
    "request_fingerprint",
    "protocol_fingerprint",
    "evaluator_version"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "pack_format": {"const": "yolozu.release_qualification"},
    "decision": {"enum": ["pass", "hold", "fail"]},
    "passed": {"type": "boolean"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "observed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unknown"]},
          "observed": {"type": ["number", "null"]},
          "threshold": {"type": "number"},
          "baseline": {"type": ["number", "null"]},
          "candidate": {"type": ["number", "null"]}
        },
        "additionalProperties": false
      }
    },
    "request_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_version": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
