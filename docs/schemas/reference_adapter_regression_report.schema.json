{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reference Adapter Regression Report",
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "gates",
    "summary",
    "speed",
    "run"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "ok": {
      "type": "boolean"
    },
    "run": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "speed": {
      "type": "object"
    },
    "contract": {
      "type": "object"
    },
    "gates": {
      "type": "object",
      "required": [
        "schema_drift",
        "consistency_drift",
        "metric_drift",
        "speed_drift"
      ],
      "properties": {
        "schema_drift": {
          "type": "object"
        },
        "consistency_drift": {
          "type": "object"
        },
        "metric_drift": {
          "type": "object"
        },
        "speed_drift": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "predictions_sha256": {
      "type": "string"
    },
    "baseline_path": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
