{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yolozu.dev/schemas/bop_download_manifest.schema.json",
  "title": "YOLOZU BOP download manifest",
  "type": "object",
  "required": ["schema_version", "kind", "complete", "dataset", "source", "archives"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kind": { "type": "string", "const": "bop_download_manifest" },
    "complete": { "type": "boolean" },
    "dataset": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "format": "uri" },
    "license": {
      "type": ["object", "null"],
      "properties": {
        "spdx": { "type": "string" },
        "source": { "type": "string", "format": "uri" },
        "dataset_card": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "archives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "cache_path", "bytes", "sha256", "extraction_status"],
        "properties": {
          "name": { "type": "string", "pattern": "^[^/\\\\]+\\.zip$" },
          "url": { "type": "string", "format": "uri" },
          "cache_path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "extraction_status": {
            "type": "string",
            "enum": ["complete_cached", "complete_extracted", "partial_quota"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
