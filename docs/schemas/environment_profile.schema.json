{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.toppymicros.com/yolozu/schemas/environment_profile.schema.json",
  "title": "YOLOZU EnvironmentProfile v1",
  "description": "Privacy-safe measured configuration facts for future Experimental adaptive routing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collector_id",
    "collector_version",
    "collected_at",
    "os",
    "cpu",
    "total_memory",
    "accelerators",
    "runtimes",
    "power_performance_mode",
    "probe_issues",
    "environment_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "collector_id": { "$ref": "#/$defs/short_id" },
    "collector_version": { "$ref": "#/$defs/id" },
    "collected_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "os": { "$ref": "#/$defs/os_probe" },
    "cpu": { "$ref": "#/$defs/cpu_probe" },
    "total_memory": { "$ref": "#/$defs/memory_probe" },
    "accelerators": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/accelerator_probe" }
    },
    "runtimes": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/runtime_probe" }
    },
    "power_performance_mode": { "$ref": "#/$defs/power_probe" },
    "probe_issues": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/probe_issue" }
    },
    "environment_fingerprint": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
    },
    "short_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "probe_status": {
      "enum": ["present", "absent", "unsupported", "failed"]
    },
    "safe_text_128": { "type": "string", "minLength": 1, "maxLength": 128 },
    "safe_text_256": { "type": "string", "minLength": 1, "maxLength": 256 },
    "core_probe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_status", "value"],
          "properties": {
            "probe_status": { "const": "present" },
            "value": { "type": "integer", "minimum": 1, "maximum": 1048576 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_status"],
          "properties": {
            "probe_status": { "enum": ["absent", "unsupported", "failed"] }
          }
        }
      ]
    },
    "memory_probe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_status", "value_bytes"],
          "properties": {
            "probe_status": { "const": "present" },
            "value_bytes": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_status"],
          "properties": {
            "probe_status": { "enum": ["absent", "unsupported", "failed"] }
          }
        }
      ]
    },
    "os_probe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_status", "name", "version", "architecture"],
          "properties": {
            "probe_status": { "const": "present" },
            "name": { "$ref": "#/$defs/safe_text_128" },
            "version": { "$ref": "#/$defs/safe_text_128" },
            "architecture": { "$ref": "#/$defs/safe_text_128" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_status"],
          "properties": {
            "probe_status": { "enum": ["absent", "unsupported", "failed"] }
          }
        }
      ]
    },
    "cpu_probe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_status", "model", "logical_cores", "physical_cores"],
          "properties": {
            "probe_status": { "const": "present" },
            "model": { "$ref": "#/$defs/safe_text_256" },
            "logical_cores": { "$ref": "#/$defs/core_probe" },
            "physical_cores": { "$ref": "#/$defs/core_probe" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_status"],
          "properties": {
            "probe_status": { "enum": ["absent", "unsupported", "failed"] }
          }
        }
      ]
    },
    "accelerator_probe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["accelerator_id", "probe_status", "kind", "vendor", "model", "device_count", "memory"],
          "properties": {
            "accelerator_id": { "$ref": "#/$defs/short_id" },
            "probe_status": { "const": "present" },
            "kind": { "$ref": "#/$defs/short_id" },
            "vendor": { "$ref": "#/$defs/safe_text_128" },
            "model": { "$ref": "#/$defs/safe_text_256" },
            "device_count": { "type": "integer", "minimum": 1, "maximum": 256 },
            "memory": { "$ref": "#/$defs/memory_probe" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["accelerator_id", "probe_status"],
          "properties": {
            "accelerator_id": { "$ref": "#/$defs/short_id" },
            "probe_status": { "enum": ["absent", "unsupported", "failed"] }
          }
        }
      ]
    },
    "runtime_probe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime_id", "probe_status", "version", "provider_ids"],
          "properties": {
            "runtime_id": { "$ref": "#/$defs/short_id" },
            "probe_status": { "const": "present" },
            "version": { "$ref": "#/$defs/safe_text_128" },
            "provider_ids": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime_id", "probe_status"],
          "properties": {
            "runtime_id": { "$ref": "#/$defs/short_id" },
            "probe_status": { "enum": ["absent", "unsupported", "failed"] }
          }
        }
      ]
    },
    "power_probe": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_status", "mode"],
          "properties": {
            "probe_status": { "const": "present" },
            "mode": { "$ref": "#/$defs/short_id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["probe_status"],
          "properties": {
            "probe_status": { "enum": ["absent", "unsupported", "failed"] }
          }
        }
      ]
    },
    "probe_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "status", "code"],
      "properties": {
        "probe_id": { "$ref": "#/$defs/short_id" },
        "status": { "enum": ["unsupported", "failed"] },
        "code": { "$ref": "#/$defs/short_id" }
      }
    }
  }
}
