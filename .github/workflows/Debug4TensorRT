name: gpu-ngc

on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  trt_and_opencv_cuda:
    runs-on: [self-hosted, linux, x64, gpu]   # あなたのrunnerラベルに合わせて
    steps:
      - uses: actions/checkout@v4

      - name: Login to NGC
        env:
          NGC_API_KEY: ${{ secrets.NGC_API_KEY }}
        run: |
          echo "${NGC_API_KEY}" | docker login nvcr.io -u '$oauthtoken' --password-stdin

      - name: Sanity (GPU visible)
        run: |
          nvidia-smi
          docker run --rm --gpus all nvcr.io/nvidia/cuda:12.4.1-base-ubuntu22.04 nvidia-smi

      - name: TensorRT pipeline (example)
        run: |
          docker pull nvcr.io/nvidia/tensorrt:24.08-py3
          docker run --rm --gpus all \
            -v "${{ github.workspace }}:/workspace" -w /workspace \
            nvcr.io/nvidia/tensorrt:24.08-py3 \
            bash -lc '
              python3 --version
              nvidia-smi
              # ここに YOLOZU の trt build/export/eval/latency コマンドを入れる
              # 例: python3 tools/export_trt.py ...
            '

      - name: OpenCV CUDA (example approach)
        run: |
          echo "OpenCV-CUDAはNGCベース上でビルド/導入が必要。ここにビルド/テスト手順を追加。"
