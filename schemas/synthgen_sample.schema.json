{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toppymicroservices.github.io/yolozu/schemas/synthgen_sample.schema.json",
  "title": "YOLOZU SynthGen Sample Contract v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "image",
    "depth_ndc",
    "inst_id",
    "sem_id",
    "kpts2d",
    "prompt",
    "scene_spec",
    "schema_id",
    "schema_version",
    "asset_ids",
    "inst_map"
  ],
  "properties": {
    "image": {
      "description": "RGB image payload (inline array or file reference).",
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "depth_ndc": {
      "description": "Normalized depth payload in [0,1] (inline array or file reference).",
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "inst_id": {
      "description": "Instance id map payload (inline array or file reference).",
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "sem_id": {
      "description": "Semantic id map payload (inline array or file reference).",
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "kpts2d": {
      "description": "2D keypoints payload [N_inst,K,3] (inline array or file reference).",
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "scene_spec": {
      "description": "Scene metadata JSON object or JSON string. Samples with 3D labels must declare coordinate_system=rhs_x_right_y_up_z_back; runtime validation enforces nested transforms.",
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inst_map": {
      "description": "Instance mapping JSON object or JSON string.",
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "bbox2d_visible": {
      "description": "Optional float32[N_inst,4] visible boxes in half-open xyxy_abs format, or a path to the array.",
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "kpts3d_object": {
      "description": "Optional canonical right-handed object-space keypoints [N_inst,K,3].",
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "pose_obj2cam": {
      "description": "Optional rigid right-handed object-to-camera transform, recomposed as world_to_camera @ object_to_world.",
      "oneOf": [
        {
          "type": "array"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  }
}
