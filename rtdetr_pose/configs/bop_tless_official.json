{
  "dataset": {
    "root": "../data/bop-yolozu-tless-official",
    "split": "train2017",
    "format": "yolo"
  },
  "model": {
    "num_classes": 30,
    "num_keypoints": 4,
    "hidden_dim": 64,
    "num_queries": 50,
    "use_uncertainty": false,
    "backbone_name": "cspresnet",
    "stem_channels": 16,
    "backbone_channels": [32, 64, 128],
    "stage_blocks": [1, 1, 1],
    "use_sppf": true,
    "use_level_embed": true,
    "num_encoder_layers": 1,
    "num_decoder_layers": 2,
    "nhead": 4,
    "encoder_dim_feedforward": 128,
    "decoder_dim_feedforward": 128,
    "backbone_kwargs": {}
  },
  "loss": {
    "name": "default",
    "task_aligner": "none",
    "weights": {
      "cls": 1.0,
      "box": 2.0,
      "kp": 0.1,
      "z": 1.0,
      "rot": 1.0,
      "off": 0.5,
      "t": 0.5
    }
  },
  "train": {
    "batch_size": 2,
    "lr": 0.001,
    "epochs": 5
  }
}
