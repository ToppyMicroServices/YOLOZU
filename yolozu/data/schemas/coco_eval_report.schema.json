{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YOLOZU COCO Eval Report",
  "description": "Report payload emitted by yolozu eval-coco and tools/eval_coco.py. Evaluation is strict by default; failed runs overwrite stale success artifacts with status=failed.",
  "type": "object",
  "required": ["timestamp", "dataset", "predictions", "bbox_format", "metrics", "stats", "dry_run", "counts", "warnings"],
  "properties": {
    "report_schema_version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["ok", "failed"] },
    "ok": { "type": "boolean" },
    "timestamp": { "type": "string" },
    "protocol_id": { "type": ["string", "null"] },
    "protocol": { "type": ["object", "null"], "additionalProperties": true },
    "dataset": { "type": "string" },
    "split": { "type": ["string", "null"] },
    "split_requested": { "type": ["string", "null"] },
    "predictions": { "type": "string" },
    "bbox_format": { "type": "string" },
    "max_images": { "type": ["integer", "null"] },
    "normalization": {
      "type": "object",
      "properties": {
        "classes": { "type": ["string", "null"] },
        "assume_class_id_is_category_id": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["mode", "repair_enabled"],
      "properties": {
        "mode": { "type": "string", "enum": ["strict", "repair"] },
        "repair_enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "required": ["map50_95", "map50", "map75", "ar100"],
      "properties": {
        "map50_95": { "type": ["number", "null"] },
        "map50": { "type": ["number", "null"] },
        "map75": { "type": ["number", "null"] },
        "ar100": { "type": ["number", "null"] }
      },
      "additionalProperties": true
    },
    "stats": { "type": "array", "items": {} },
    "dry_run": { "type": "boolean" },
    "counts": {
      "type": "object",
      "required": ["images", "detections"],
      "properties": {
        "dataset_images_total": { "type": "integer", "minimum": 0 },
        "images": { "type": "integer", "minimum": 0 },
        "prediction_images_total": { "type": "integer", "minimum": 0 },
        "prediction_images_evaluated": { "type": "integer", "minimum": 0 },
        "prediction_images_excluded": { "type": "integer", "minimum": 0 },
        "selected_images_without_predictions": { "type": "integer", "minimum": 0 },
        "detections_input": { "type": "integer", "minimum": 0 },
        "detections": { "type": "integer", "minimum": 0 },
        "detections_excluded": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": {
      "type": "object",
      "required": ["code", "message", "category"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string" },
        "details": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": { "required": ["error"] }
    }
  ]
}
