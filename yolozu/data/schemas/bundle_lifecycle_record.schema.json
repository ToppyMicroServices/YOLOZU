{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.toppymicros.com/yolozu/schemas/bundle_lifecycle_record.schema.json",
  "title": "YOLOZU BundleLifecycleRecord v1",
  "description": "One record in the global append-only bundle state and per-channel pointer stream.",
  "oneOf": [
    { "$ref": "#/$defs/bundle_global" },
    { "$ref": "#/$defs/channel_assignment" },
    { "$ref": "#/$defs/channel_none" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "component": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "nullable_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "review_reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "const": "public_repository_id" }, "value": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "status"],
          "properties": { "kind": { "const": "site_local_status" }, "status": { "enum": ["present", "not_applicable"] } }
        }
      ]
    },
    "artifact_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "review_state"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/component" },
        "review_state": { "enum": ["approved", "unknown", "blocked"] }
      }
    },
    "profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_digest"],
      "properties": { "profile_id": { "$ref": "#/$defs/component" }, "profile_digest": { "$ref": "#/$defs/sha256" } }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_digest", "activation_id", "activation_digest", "trust_domain_claim"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/component" },
        "profile_digest": { "$ref": "#/$defs/sha256" },
        "activation_id": { "$ref": "#/$defs/id" },
        "activation_digest": { "$ref": "#/$defs/sha256" },
        "trust_domain_claim": { "enum": ["yolozu_managed", "site_managed", "operator_asserted", "unknown"] }
      }
    },
    "common": {
      "type": "object",
      "required": ["schema_version", "stream_id", "sequence", "previous_event_digest", "event_scope", "event_type", "reviewer_role_id", "review_reference", "issuer_claim", "reason", "occurred_at", "event_digest"],
      "properties": {
        "schema_version": { "const": 1 },
        "stream_id": { "const": "bundle-lifecycle-v1" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "previous_event_digest": { "$ref": "#/$defs/sha256" },
        "event_scope": { "enum": ["bundle_global", "channel_assignment", "channel_none"] },
        "event_type": { "enum": ["register_global", "disable", "enable", "license_review", "revoke", "candidate_registration", "public_assignment", "channel_none"] },
        "reviewer_role_id": { "enum": ["repo_maintainer", "release_reviewer", "site_operator", "automation"] },
        "review_reference": { "$ref": "#/$defs/review_reference" },
        "issuer_claim": { "enum": ["repository_source", "site_source", "operator_source", "unknown"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "occurred_at": { "$ref": "#/$defs/utc" },
        "event_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "bundle_global": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "stream_id", "sequence", "previous_event_digest", "event_scope", "event_type", "reviewer_role_id", "review_reference", "issuer_claim", "reason", "occurred_at", "event_digest", "family_id", "bundle_spec_digest", "artifact_set_digest", "bundle_state", "artifact_license_reviews"],
          "properties": {
            "schema_version": {}, "stream_id": {}, "sequence": {}, "previous_event_digest": {}, "event_scope": { "const": "bundle_global" }, "event_type": { "enum": ["register_global", "disable", "enable", "license_review", "revoke"] }, "reviewer_role_id": {}, "review_reference": {}, "issuer_claim": {}, "reason": {}, "occurred_at": {}, "event_digest": {},
            "family_id": { "$ref": "#/$defs/component" },
            "bundle_spec_digest": { "$ref": "#/$defs/sha256" },
            "artifact_set_digest": { "$ref": "#/$defs/sha256" },
            "bundle_state": { "enum": ["enabled", "disabled", "revoked"] },
            "artifact_license_reviews": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/artifact_review" } }
          }
        }
      ]
    },
    "channel_assignment": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "stream_id", "sequence", "previous_event_digest", "event_scope", "event_type", "reviewer_role_id", "review_reference", "issuer_claim", "reason", "occurred_at", "event_digest", "family_id", "channel", "target_bundle_spec_digest", "target_artifact_set_digest", "target_artifact_license_reviews", "support_profile_index_head", "profile_set_record_id", "profile_set_record_digest", "profile_set_digest", "profiles", "evidence_bindings"],
          "properties": {
            "schema_version": {}, "stream_id": {}, "sequence": {}, "previous_event_digest": {}, "event_scope": { "const": "channel_assignment" }, "event_type": { "enum": ["candidate_registration", "public_assignment"] }, "reviewer_role_id": {}, "review_reference": {}, "issuer_claim": {}, "reason": {}, "occurred_at": {}, "event_digest": {},
            "family_id": { "$ref": "#/$defs/component" },
            "channel": { "enum": ["Candidate", "Experimental", "Stable"] },
            "target_bundle_spec_digest": { "$ref": "#/$defs/sha256" },
            "target_artifact_set_digest": { "$ref": "#/$defs/sha256" },
            "target_artifact_license_reviews": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/artifact_review" } },
            "support_profile_index_head": { "$ref": "#/$defs/sha256" },
            "profile_set_record_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "profile_set_record_digest": { "$ref": "#/$defs/nullable_sha256" },
            "profile_set_digest": { "$ref": "#/$defs/sha256" },
            "profiles": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/profile_reference" } },
            "evidence_bindings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/evidence_binding" } }
          }
        }
      ]
    },
    "channel_none": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "stream_id", "sequence", "previous_event_digest", "event_scope", "event_type", "reviewer_role_id", "review_reference", "issuer_claim", "reason", "occurred_at", "event_digest", "family_id", "channel", "profile_set_digest", "profiles", "evidence_bindings", "prior_bundle_spec_digest", "prior_artifact_set_digest", "prior_support_profile_index_head", "prior_profile_set_record_digest", "prior_profile_set_digest"],
          "properties": {
            "schema_version": {}, "stream_id": {}, "sequence": {}, "previous_event_digest": {}, "event_scope": { "const": "channel_none" }, "event_type": { "const": "channel_none" }, "reviewer_role_id": {}, "review_reference": {}, "issuer_claim": {}, "reason": {}, "occurred_at": {}, "event_digest": {},
            "family_id": { "$ref": "#/$defs/component" },
            "channel": { "enum": ["Candidate", "Experimental", "Stable"] },
            "profile_set_digest": { "$ref": "#/$defs/sha256" },
            "profiles": { "type": "array", "maxItems": 0 },
            "evidence_bindings": { "type": "array", "maxItems": 0 },
            "prior_bundle_spec_digest": { "$ref": "#/$defs/nullable_sha256" },
            "prior_artifact_set_digest": { "$ref": "#/$defs/nullable_sha256" },
            "prior_support_profile_index_head": { "$ref": "#/$defs/sha256" },
            "prior_profile_set_record_digest": { "$ref": "#/$defs/nullable_sha256" },
            "prior_profile_set_digest": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    }
  }
}
