{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.toppymicros.com/yolozu/schemas/stream_job_spec.schema.json",
  "title": "YOLOZU StreamJobSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task", "source", "required_duration_seconds",
    "warmup_frame_count",
    "min_sustained_fps", "max_p95_latency_ms", "queue_capacity_frames",
    "max_queued_decoded_bytes", "drop_policy", "max_drop_num", "max_drop_den",
    "max_consecutive_drops", "max_duration_seconds", "max_frames",
    "job_timeout_seconds", "max_results_per_frame", "max_total_results",
    "max_mask_artifacts", "max_output_files", "max_output_bytes",
    "max_mask_bytes", "mask_chunk_bytes", "callback_max_items",
    "callback_max_bytes", "max_decoder_rss_bytes",
    "max_stream_job_peak_rss_bytes", "max_accelerator_process_tree_peak_bytes",
    "camera_pool_capacity_frames", "camera_pool_bytes", "stride_policy_id",
    "decoded_stride_min_bytes", "decoded_stride_max_bytes",
    "source_admission_policy_id", "source_admission_policy_version",
    "output_cadence_id", "latency_interval_id", "decoded_layout_id",
    "camera_pool_policy_id", "camera_pool_policy_version",
    "camera_eligibility_policy_id", "mask_encoding_id",
    "mask_encoding_version", "decoder_policy", "memory_collector",
    "quality_requirement", "network_policy", "source_probe_timeout_seconds",
    "camera_open_timeout_seconds", "camera_first_frame_timeout_seconds",
    "runner_probe_timeout_seconds", "runner_load_timeout_seconds",
    "frame_decode_timeout_seconds", "frame_predict_timeout_seconds",
    "output_step_timeout_seconds", "close_timeout_seconds",
    "cancellation_grace_seconds"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"enum": ["object_detection", "instance_segmentation"]},
    "source": {"$ref": "#/$defs/source"},
    "required_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "warmup_frame_count": {"type": "integer", "minimum": 0, "maximum": 864000},
    "min_sustained_fps": {"$ref": "#/$defs/fps_decimal"},
    "max_p95_latency_ms": {"$ref": "#/$defs/positive_decimal"},
    "queue_capacity_frames": {"type": "integer", "minimum": 1, "maximum": 64},
    "max_queued_decoded_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
    "drop_policy": {"enum": ["block", "drop_oldest"]},
    "max_drop_num": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "max_drop_den": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "max_consecutive_drops": {"type": "integer", "minimum": 0, "maximum": 864000},
    "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_frames": {"type": "integer", "minimum": 1, "maximum": 864000},
    "job_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_results_per_frame": {"type": "integer", "minimum": 1, "maximum": 1000},
    "max_total_results": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "max_mask_artifacts": {"type": "integer", "minimum": 0, "maximum": 10000},
    "max_output_files": {"type": "integer", "minimum": 4, "maximum": 10004},
    "max_output_bytes": {"const": 4294967296},
    "max_mask_bytes": {"const": 67108864},
    "mask_chunk_bytes": {"const": 1048576},
    "callback_max_items": {"const": 64},
    "callback_max_bytes": {"const": 67108864},
    "max_decoder_rss_bytes": {"type": "integer", "minimum": 67108864, "maximum": 2147483648},
    "max_stream_job_peak_rss_bytes": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "max_accelerator_process_tree_peak_bytes": {"type": ["integer", "null"], "minimum": 1, "maximum": 18446744073709551615},
    "camera_pool_capacity_frames": {"type": ["integer", "null"], "minimum": 1, "maximum": 64},
    "camera_pool_bytes": {"type": ["integer", "null"], "minimum": 1, "maximum": 18446744073709551615},
    "stride_policy_id": {"const": "width_times_3_to_4_v1"},
    "decoded_stride_min_bytes": {"type": "integer", "minimum": 3, "maximum": 32768},
    "decoded_stride_max_bytes": {"type": "integer", "minimum": 4, "maximum": 32768},
    "source_admission_policy_id": {"const": "rational_monotonic_due_v1"},
    "source_admission_policy_version": {"const": 1},
    "output_cadence_id": {"const": "one_frame_result_per_processed_frame_v1"},
    "latency_interval_id": {"const": "stream_due_to_callback_enqueue_v1"},
    "decoded_layout_id": {"const": "uint8_rgb_bgr_strided_v1"},
    "camera_pool_policy_id": {"const": "caller_preallocated_fixed_pool_v1"},
    "camera_pool_policy_version": {"const": 1},
    "camera_eligibility_policy_id": {"const": "exactly_one_reenumerate_before_open_v1"},
    "mask_encoding_id": {"const": "png_binary_mask_v1"},
    "mask_encoding_version": {"const": 1},
    "decoder_policy": {"$ref": "#/$defs/decoder_policy"},
    "memory_collector": {"$ref": "#/$defs/memory_collector"},
    "quality_requirement": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/quality_requirement"}]},
    "network_policy": {"const": "deny"},
    "source_probe_timeout_seconds": {"const": 10},
    "camera_open_timeout_seconds": {"const": 10},
    "camera_first_frame_timeout_seconds": {"const": 10},
    "runner_probe_timeout_seconds": {"const": 30},
    "runner_load_timeout_seconds": {"const": 600},
    "frame_decode_timeout_seconds": {"const": 5},
    "frame_predict_timeout_seconds": {"const": 30},
    "output_step_timeout_seconds": {"const": 30},
    "close_timeout_seconds": {"const": 10},
    "cancellation_grace_seconds": {"const": 5}
  },
  "allOf": [
    {
      "if": {"properties": {"drop_policy": {"const": "block"}}, "required": ["drop_policy"]},
      "then": {
        "properties": {
          "max_drop_num": {"const": 0},
          "max_drop_den": {"const": 1},
          "max_consecutive_drops": {"const": 0}
        }
      }
    },
    {
      "if": {"properties": {"source": {"properties": {"source_kind": {"const": "local_mp4"}}, "required": ["source_kind"]}}, "required": ["source"]},
      "then": {"properties": {"camera_pool_capacity_frames": {"type": "null"}, "camera_pool_bytes": {"type": "null"}}},
      "else": {"properties": {"camera_pool_capacity_frames": {"type": "integer", "minimum": 1, "maximum": 64}, "camera_pool_bytes": {"type": "integer", "minimum": 1}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_decimal": {"type": "string", "pattern": "^(?:0|-?(?:(?:[1-9][0-9]{0,17})(?:\\.[0-9]{0,8}[1-9])?|0\\.[0-9]{0,8}[1-9]))$", "maxLength": 29},
    "positive_decimal": {"allOf": [{"$ref": "#/$defs/canonical_decimal"}, {"not": {"const": "0"}}, {"not": {"pattern": "^-"}}]},
    "fps_decimal": {"type": "string", "pattern": "^(?:0\\.[1-9][0-9]{0,8}|(?:[1-9]|[1-9][0-9]|1[0-9]{2}|2[0-3][0-9])(?:\\.[0-9]{0,8}[1-9])?|240)$", "maxLength": 13},
    "source": {
      "type": "object",
      "description": "Transport shape and scalar bounds. validate_stream_job_spec is the normative semantic validator for gcd(source_rate_num, source_rate_den) = 1, the exact 0.1..240 rate quotient, and width * height <= 33177600.",
      "additionalProperties": false,
      "required": ["source_kind", "width", "height", "source_rate_num", "source_rate_den", "container", "codec", "pixel_format", "provider_id", "capability_format"],
      "properties": {
        "source_kind": {"enum": ["local_mp4", "local_camera"]},
        "width": {"type": "integer", "minimum": 1, "maximum": 8192},
        "height": {"type": "integer", "minimum": 1, "maximum": 8192},
        "source_rate_num": {"type": "integer", "minimum": 1, "maximum": 240000},
        "source_rate_den": {"type": "integer", "minimum": 1, "maximum": 1001},
        "container": {"enum": ["mp4", null]},
        "codec": {"enum": ["h264_avc", null]},
        "pixel_format": {"enum": ["yuv420p8", "rgb24", "bgr24"]},
        "provider_id": {"enum": ["contract_fixture_camera_v1", null]},
        "capability_format": {"enum": ["rgb24", "bgr24", null]}
      },
      "oneOf": [
        {
          "properties": {
            "source_kind": {"const": "local_mp4"}, "container": {"const": "mp4"},
            "codec": {"const": "h264_avc"}, "pixel_format": {"const": "yuv420p8"},
            "provider_id": {"type": "null"}, "capability_format": {"type": "null"}
          }
        },
        {
          "properties": {
            "source_kind": {"const": "local_camera"}, "container": {"type": "null"},
            "codec": {"type": "null"}, "pixel_format": {"const": "rgb24"},
            "provider_id": {"const": "contract_fixture_camera_v1"},
            "capability_format": {"const": "rgb24"}
          }
        },
        {
          "properties": {
            "source_kind": {"const": "local_camera"}, "container": {"type": "null"},
            "codec": {"type": "null"}, "pixel_format": {"const": "bgr24"},
            "provider_id": {"const": "contract_fixture_camera_v1"},
            "capability_format": {"const": "bgr24"}
          }
        }
      ]
    },
    "decoder_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version", "backend_id", "backend_version", "enforcement_id", "allowed_profiles", "allowed_levels", "pixel_format", "max_reference_frames", "max_dpb_bytes", "max_gop_frames", "max_sample_bytes", "max_nal_unit_bytes", "probe_input_bytes", "probe_box_count", "probe_nesting_depth", "policy_digest"],
      "properties": {
        "policy_id": {"const": "bounded_h264_decoder_v1"},
        "policy_version": {"const": 1},
        "backend_id": {"$ref": "#/$defs/id"},
        "backend_version": {"$ref": "#/$defs/id"},
        "enforcement_id": {"const": "bounded_process_tree_hard_limit_v1"},
        "allowed_profiles": {"const": ["constrained_baseline", "main", "high"]},
        "allowed_levels": {"const": ["3.0", "3.1", "3.2", "4.0", "4.1", "4.2", "5.0", "5.1"]},
        "pixel_format": {"const": "yuv420p8"},
        "max_reference_frames": {"const": 16},
        "max_dpb_bytes": {"const": 536870912},
        "max_gop_frames": {"const": 600},
        "max_sample_bytes": {"const": 67108864},
        "max_nal_unit_bytes": {"const": 33554432},
        "probe_input_bytes": {"const": 67108864},
        "probe_box_count": {"const": 100000},
        "probe_nesting_depth": {"const": 32},
        "policy_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "memory_collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector_id", "collector_version", "source", "scope"],
      "properties": {
        "collector_id": {"$ref": "#/$defs/id"},
        "collector_version": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/id"},
        "scope": {"const": "whole_stream_job_process_tree_v1"}
      }
    },
    "quality_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "direction", "threshold", "evaluation_dataset_id", "evaluation_dataset_sha256", "evaluation_protocol_sha256", "evaluation_vocabulary_id", "task"],
      "properties": {
        "metric_id": {"$ref": "#/$defs/id"},
        "direction": {"enum": ["higher_is_better", "lower_is_better"]},
        "threshold": {"$ref": "#/$defs/canonical_decimal"},
        "evaluation_dataset_id": {"$ref": "#/$defs/id"},
        "evaluation_dataset_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_vocabulary_id": {"$ref": "#/$defs/id"},
        "task": {"enum": ["object_detection", "instance_segmentation"]}
      }
    }
  }
}
