{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.toppymicros.com/yolozu/schemas/stream_workload_profile.schema.json",
  "title": "YOLOZU StreamWorkloadProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "collector_id", "collector_version", "stream_job", "workload_fingerprint"],
  "properties": {
    "schema_version": {"const": 1},
    "collector_id": {"$ref": "#/$defs/id"},
    "collector_version": {"$ref": "#/$defs/id"},
    "stream_job": {"$ref": "stream_job_spec.schema.json"},
    "workload_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
