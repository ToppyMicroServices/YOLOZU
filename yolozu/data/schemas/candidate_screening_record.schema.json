{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.toppymicros.com/yolozu/schemas/candidate_screening_record.schema.json",
  "title": "YOLOZU CandidateScreeningRecord v1",
  "description": "Immutable non-executing screening decision for one candidate source revision and requested capability. Trust is derived by the loader and is not a record field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stream_key",
    "sequence",
    "previous_record_digest",
    "record_id",
    "record_digest",
    "candidate",
    "mechanical_checks",
    "human_review",
    "overall_status",
    "reason_codes",
    "issuer_claim",
    "reviewed_at",
    "supersedes_record_id",
    "supersedes_record_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "stream_key": { "$ref": "#/$defs/sha256" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "previous_record_digest": { "$ref": "#/$defs/sha256" },
    "record_id": { "$ref": "#/$defs/id" },
    "record_digest": { "$ref": "#/$defs/sha256" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "mechanical_checks": { "$ref": "#/$defs/mechanical_checks" },
    "human_review": { "$ref": "#/$defs/human_review" },
    "overall_status": { "enum": ["pass", "hold", "reject"] },
    "reason_codes": {
      "type": "array",
      "maxItems": 14,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "issuer_claim": {
      "enum": [
        "repository_source",
        "site_source",
        "operator_source",
        "unknown"
      ]
    },
    "reviewed_at": { "$ref": "#/$defs/utc" },
    "supersedes_record_id": { "$ref": "#/$defs/nullable_id" },
    "supersedes_record_digest": { "$ref": "#/$defs/nullable_sha256" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
    },
    "nullable_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "public_repository_id" },
            "value": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "status"],
          "properties": {
            "kind": { "const": "site_local_status" },
            "status": { "enum": ["present", "not_available"] }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "path"],
      "properties": {
        "scheme": { "const": "https" },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$",
          "maxLength": 253
        },
        "path": {
          "type": "string",
          "pattern": "^/[^?#\\\\]*$",
          "maxLength": 4096
        }
      }
    },
    "requested_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "prompt_modes", "output_interface_contract_id"],
      "properties": {
        "task": { "enum": ["object_detection", "instance_segmentation"] },
        "prompt_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["fixed_classes", "text"] }
        },
        "output_interface_contract_id": { "const": "predictions-v2" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "source",
        "immutable_revision",
        "requested_capability"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/source" },
        "immutable_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "requested_capability": { "$ref": "#/$defs/requested_capability" }
      }
    },
    "result": { "enum": ["pass", "unknown", "fail"] },
    "simple_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "reference"],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "revision_kind", "reference"],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "revision_kind": { "enum": ["immutable", "mutable", "unknown"] },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "integrity_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "procedure_id", "expected_sha256", "reference"],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "procedure_id": { "$ref": "#/$defs/nullable_id" },
        "expected_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "license_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "spdx_id", "reference"],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "spdx_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
        },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "weight_source_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "source_kind",
        "procedure_id",
        "expected_sha256",
        "reference"
      ],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "source_kind": {
          "enum": [
            "official_release",
            "official_repository",
            "unverified",
            "unknown"
          ]
        },
        "procedure_id": { "$ref": "#/$defs/nullable_id" },
        "expected_sha256": { "$ref": "#/$defs/nullable_sha256" },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "local_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "mode", "reference"],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "mode": {
          "enum": [
            "local_artifacts",
            "downloadable_artifacts",
            "hosted_only",
            "unknown"
          ]
        },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "interface_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "interface_contract_id",
        "mapping_revision",
        "reference"
      ],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "interface_contract_id": {
          "type": ["string", "null"],
          "enum": ["predictions-v2", null]
        },
        "mapping_revision": { "$ref": "#/$defs/nullable_id" },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "runtime_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "runtime_ids",
        "provider_ids",
        "requires_new_surface",
        "reference"
      ],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "runtime_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "provider_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "requires_new_surface": { "type": "boolean" },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "compute_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "estimated_compute_operations",
        "estimated_peak_memory_bytes",
        "reference"
      ],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "estimated_compute_operations": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "estimated_peak_memory_bytes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "status", "reference"],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "status": { "enum": ["maintained", "stale", "unknown"] },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "security_supply_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "status", "reference"],
      "properties": {
        "result": { "$ref": "#/$defs/result" },
        "status": {
          "enum": ["no_known_concern", "concern_present", "unknown"]
        },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "mechanical_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_provenance",
        "source_integrity",
        "code_license",
        "weight_license",
        "dataset_evaluation_license",
        "weight_source_integrity",
        "local_availability",
        "task_prompt_output_fit",
        "predictions_interface_mapping",
        "runtime_provider",
        "compute_memory",
        "maintenance",
        "security_supply_chain"
      ],
      "properties": {
        "source_provenance": { "$ref": "#/$defs/source_provenance" },
        "source_integrity": { "$ref": "#/$defs/integrity_assessment" },
        "code_license": { "$ref": "#/$defs/license_assessment" },
        "weight_license": { "$ref": "#/$defs/license_assessment" },
        "dataset_evaluation_license": { "$ref": "#/$defs/license_assessment" },
        "weight_source_integrity": { "$ref": "#/$defs/weight_source_integrity" },
        "local_availability": { "$ref": "#/$defs/local_availability" },
        "task_prompt_output_fit": { "$ref": "#/$defs/simple_assessment" },
        "predictions_interface_mapping": { "$ref": "#/$defs/interface_mapping" },
        "runtime_provider": { "$ref": "#/$defs/runtime_provider" },
        "compute_memory": { "$ref": "#/$defs/compute_memory" },
        "maintenance": { "$ref": "#/$defs/maintenance" },
        "security_supply_chain": { "$ref": "#/$defs/security_supply_chain" }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer_role_id", "review_reference"],
      "properties": {
        "status": { "enum": ["reviewed", "unreviewed"] },
        "reviewer_role_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}$"
        },
        "review_reference": { "$ref": "#/$defs/reference" }
      }
    }
  }
}
